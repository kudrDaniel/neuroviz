{
  "version": 1,
  "rules": [
    {
      "id": "onset-pulse",
      "priority": 100,
      "when": {
        "event": "onset",
        "filters": {
          "confidence": {
            "min": 0.6
          }
        }
      },
      "actions": [
        {
          "type": "set",
          "param": "pulse",
          "value": 1.0,
          "decayMs": 150
        }
      ]
    },
    {
      "id": "offset-release",
      "priority": 95,
      "when": {
        "event": "offset",
        "filters": {
          "confidence": {
            "min": 0.6
          }
        }
      },
      "actions": [
        {
          "type": "set",
          "param": "release",
          "value": 1.0,
          "decayMs": 400
        }
      ]
    },
    {
      "id": "novelty-shiver",
      "priority": 200,
      "when": {
        "event": "novelty",
        "filters": {
          "params.error_magnitude": {
            "min": 4.0
          }
        }
      },
      "actions": [
        {
          "type": "set",
          "param": "shiver",
          "value": 1.0,
          "decayMs": 1000
        },
        {
          "type": "set",
          "param": "cortex_flash",
          "value": 0.6,
          "decayMs": 400
        }
      ]
    },
    {
      "id": "azimuth-pan",
      "priority": 90,
      "when": {
        "event": "azimuth_estimate"
      },
      "actions": [
        {
          "type": "set",
          "param": "pan_x",
          "param_from_event": "azimuth_norm",
          "decayMs": 100
        }
      ]
    },
    {
      "id": "pitch-brightness",
      "priority": 80,
      "when": {
        "event": "pitch_salience"
      },
      "actions": [
        {
          "type": "set",
          "param": "pitch_height",
          "param_from_event": "pitch_norm",
          "decayMs": 150
        }
      ]
    },
    {
      "id": "stream-open",
      "priority": 50,
      "when": {
        "event": "stream_boundary",
        "filters": {
          "params.open": {
            "eq": "1"
          }
        }
      },
      "actions": [
        {
          "type": "set",
          "param": "stream_glow",
          "value": 0.8,
          "decayMs": 1500
        }
      ]
    },
    {
      "id": "stream-close",
      "priority": 45,
      "when": {
        "event": "stream_boundary",
        "filters": {
          "params.open": {
            "eq": "0"
          }
        }
      },
      "actions": [
        {
          "type": "set",
          "param": "stream_fade",
          "value": 0.8,
          "decayMs": 2000
        }
      ]
    }
  ]
}
