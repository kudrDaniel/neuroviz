<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NeuroViz.App.Views.SettingsWindow"
        Title="NeuroViz — Settings"
        Width="640" Height="900"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FF14141A">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <!-- Header -->
    <TextBlock Grid.Row="0"
               Text="Settings are stored in %APPDATA%/NeuroViz/settings.json."
               Foreground="#FF8FA6C0" Margin="0,0,0,16" />

    <!-- Form -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,Auto">

      <!-- Godot executable -->
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                 Text="Godot executable (.NET / Mono build)"
                 Foreground="#FFE0E0E8" Margin="0,0,0,4" />
      <TextBox Grid.Row="1" Grid.Column="0" x:Name="GodotExeBox"
               Watermark="e.g. C:\Godot\Godot_v4.x-stable_mono_win64.exe"
               Margin="0,0,8,0" />
      <Button Grid.Row="1" Grid.Column="1" Content="Browse…"
              Click="OnBrowseGodotExe" MinWidth="90" />
      <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="GodotExeError"
                 Foreground="#FFE05A5A" Margin="0,2,0,12" IsVisible="False" />

      <!-- Godot project -->
      <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                 Text="Godot project folder (must contain project.godot)"
                 Foreground="#FFE0E0E8" Margin="0,0,0,4" />
      <TextBox Grid.Row="4" Grid.Column="0" x:Name="GodotProjectBox"
               Watermark="e.g. E:\Projects\NeuroViz\src\NeuroViz.Visualizer"
               Margin="0,0,8,0" />
      <Button Grid.Row="4" Grid.Column="1" Content="Browse…"
              Click="OnBrowseGodotProject" MinWidth="90" />
      <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="GodotProjectError"
                 Foreground="#FFE05A5A" Margin="0,2,0,12" IsVisible="False" />

      <!-- Rules -->
      <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                 Text="Rules JSON file (empty = bundled basic.json)"
                 Foreground="#FFE0E0E8" Margin="0,0,0,4" />
      <TextBox Grid.Row="7" Grid.Column="0" x:Name="RulesPathBox"
               Watermark="e.g. C:\Users\me\my-rules.json"
               Margin="0,0,8,0" />
      <Button Grid.Row="7" Grid.Column="1" Content="Browse…"
              Click="OnBrowseRules" MinWidth="90" />
      <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="RulesPathError"
                 Foreground="#FFE05A5A" Margin="0,2,0,0" IsVisible="False" />
      <!-- Visualizer: monitor + always-on-top (P2-B) -->
      <TextBlock Grid.Row="9" Grid.ColumnSpan="2"
                 Text="Visualizer window"
                 Foreground="#FFE0E0E8" Margin="0,16,0,4" />
      <TextBlock Grid.Row="10" Grid.Column="0"
                 Text="Monitor (fullscreen)"
                 Foreground="#FF8FA6C0" VerticalAlignment="Center" />
      <ComboBox Grid.Row="10" Grid.Column="1"
                x:Name="MonitorBox" MinWidth="200" HorizontalAlignment="Left" />
      <CheckBox Grid.Row="11" Grid.ColumnSpan="2"
                x:Name="AlwaysOnTopBox"
                Content="Always on top of other windows"
                Foreground="#FFE0E0E8" Margin="0,8,0,0" />
      <!-- N.9: scene selector + per-scene tuning -->
      <TextBlock Grid.Row="12" Grid.ColumnSpan="2"
                 Text="Visualizer scene"
                 Foreground="#FFE0E0E8" Margin="0,16,0,4" />
      <ComboBox Grid.Row="13" Grid.ColumnSpan="2"
                x:Name="SceneBox" MinWidth="200" HorizontalAlignment="Left">
        <ComboBoxItem Content="2D (node_2d.tscn)" Tag="2d" />
        <ComboBoxItem Content="Spike — 3D sphere (spike.tscn)" Tag="spike" />
        <ComboBoxItem Content="Neural — 2-hemisphere network (neural.tscn)" Tag="neural" />
      </ComboBox>

      <!-- Spike tuning (visible when scene = spike) -->
      <StackPanel Grid.Row="14" Grid.ColumnSpan="2" x:Name="SpikeTuningPanel" IsVisible="True">
        <TextBlock Text="Spike tuning" Foreground="#FFE0E0E8" Margin="0,16,0,4" />
        <TextBlock Text="Camera orbit speed (rad/s, 0.01–0.2)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #CameraOrbitSlider.Value, StringFormat='{}{0:F2}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="CameraOrbitSlider" Minimum="0.01" Maximum="0.2" TickFrequency="0.01" />
        <TextBlock Text="Camera Y amplitude (0.0–1.0)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #CameraYSlider.Value, StringFormat='{}{0:F2}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="CameraYSlider" Minimum="0.0" Maximum="1.0" TickFrequency="0.05" />
        <TextBlock Text="Ambient particles (20–1000)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #AmbientSlider.Value, StringFormat='{}{0:F0}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="AmbientSlider" Minimum="20" Maximum="1000" TickFrequency="10" />
        <TextBlock Text="Burst particles (20–500)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #BurstSlider.Value, StringFormat='{}{0:F0}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="BurstSlider" Minimum="20" Maximum="500" TickFrequency="10" />
      </StackPanel>

      <!-- Neural tuning (visible when scene = neural) -->
      <StackPanel Grid.Row="15" Grid.ColumnSpan="2" x:Name="NeuralTuningPanel" IsVisible="False">
        <TextBlock Text="Neural tuning" Foreground="#FFE0E0E8" Margin="0,16,0,4" />
        <TextBlock Text="Nodes per hemisphere (200–1500)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #NeuralNodesSlider.Value, StringFormat='{}{0:F0}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="NeuralNodesSlider" Minimum="200" Maximum="1500" TickFrequency="50" />
        <TextBlock Text="Edges per node (2–6)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #NeuralEdgesSlider.Value, StringFormat='{}{0:F0}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="NeuralEdgesSlider" Minimum="2" Maximum="6" TickFrequency="1" />
        <TextBlock Text="CC density (0.1–1.0)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #NeuralCCSlider.Value, StringFormat='{}{0:F2}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="NeuralCCSlider" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" />
        <TextBlock Text="Camera orbit speed (rad/s, 0.01–0.2)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #NeuralCamSpeedSlider.Value, StringFormat='{}{0:F2}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="NeuralCamSpeedSlider" Minimum="0.01" Maximum="0.2" TickFrequency="0.01" />
        <TextBlock Text="Camera Y amplitude (0.0–1.0)" Foreground="#FF8FA6C0" Margin="0,8,0,2" />
        <TextBlock Text="{Binding #NeuralCamYSlider.Value, StringFormat='{}{0:F2}'}"
                   Foreground="#FFE0E0E8" HorizontalAlignment="Right" />
        <Slider x:Name="NeuralCamYSlider" Minimum="0.0" Maximum="1.0" TickFrequency="0.05" />
      </StackPanel>

    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0" Content="Reset to defaults"
              Click="OnResetDefaults" MinWidth="130" />
      <Button Grid.Column="2" Content="Cancel"
              Click="OnCancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
      <Button Grid.Column="3" Content="Save"
              Click="OnSave" IsDefault="True" MinWidth="90" />
    </Grid>

  </Grid>
</Window>
